# MONGO_URI=mongodb://localhost:27017/approvalguard
# PORT=5000
# FAKE_GOVERNMENT_PORTAL_URL=http://localhost:6060

# # Gmail SMTP notifications. Use a Google App Password, not your normal password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-16-character-google-app-password
# SMTP_FROM=your-gmail-address@gmail.com

# # Optional real SMS notifications through Twilio.
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM=your-twilio-phone-number

# # Demo polling interval: 30 seconds.
# APPROVAL_POLL_INTERVAL_MS=30000
